<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linked databases tests (plan-links). WP0: DuckDB native smoke + contract round trips (WpZero/). WP-A owns WpA/,
       WP-B owns WpB/; Goldens/Builder/ is shared (file prefixes b- WP-B, c- WP-C). Docker integration tests against the
       compose project dbstudio-it are skipped (not failed) when DBSTUDIO_IT=0 or a server is unreachable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbStudio.Federation\DbStudio.Federation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Goldens\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
