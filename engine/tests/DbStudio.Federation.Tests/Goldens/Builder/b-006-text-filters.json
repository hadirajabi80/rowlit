  "sql": "SELECT customers.name, orders.status\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.customer_id\nWHERE customers.name ILIKE '%' || $fp1 || '%' ESCAPE '\\' AND customers.email LIKE '%' || $fp2 ESCAPE '\\' AND lower(customers.country) IN (lower($fp3), lower($fp4)) AND orders.status NOT IN ($fp5) AND orders.customer_id IN ($fp6, $fp7, $fp8) AND (orders.ref = '' OR orders.ref IS NULL OR orders.ref ILIKE $fp9 || '%' ESCAPE '\\') AND NOT (lower(orders.status) = lower($fp10) OR NOT (customers.name ILIKE '%' || $fp11 || '%' ESCAPE '\\')) AND customers.email IS NOT NULL AND orders.status <> $fp12",
