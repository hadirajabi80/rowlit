  "sql": "SELECT orders.id\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.customer_id\nWHERE orders.id > $fp1 AND orders.total BETWEEN $fp2 AND $fp3 AND orders.weight <= $fp4 AND orders.total <> $fp5 AND (orders.ordered >= $fp6 AND orders.ordered < $fp7) AND orders.ordered < $fp8 AND orders.ordered >= $fp9 AND (orders.shipped_at >= $fp10 AND orders.shipped_at < $fp11) AND orders.shipped_at > $fp12 AND (customers.created >= $fp13 AND customers.created < $fp14) AND NOT (customers.created >= $fp15 AND customers.created < $fp16) AND orders.ship_time < $fp17 AND orders.ship_time BETWEEN $fp18 AND $fp19 AND customers.vip = TRUE",
