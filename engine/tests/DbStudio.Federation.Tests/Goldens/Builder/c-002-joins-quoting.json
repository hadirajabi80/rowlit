      { "id": "t2", "alias": "shop", "table": "order", "as": "order", "x": 360, "y": 40, "collapsed": false },
      { "id": "t3", "alias": "crm", "table": "customers", "as": "customers2", "x": 360, "y": 300, "collapsed": false }
    ],
