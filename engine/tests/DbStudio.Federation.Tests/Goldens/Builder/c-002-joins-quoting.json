  "sql": "SELECT customers.\"First Name\", \"order\".total AS \"order total\", customers2.\"First Name\" AS referrer\nFROM crm.customers AS customers\nLEFT JOIN shop.\"order\" AS \"order\" ON customers.id = \"order\".customer_id AND lower(trim(customers.email)) = lower(trim(\"order\".email))\nFULL JOIN crm.customers AS customers2 ON customers.referred_by = customers2.id\nORDER BY \"order total\" DESC NULLS LAST, \"order\".id ASC",
