  "sql": "SELECT upper(customers.country) AS Country, sum(orders.total * 1.2) AS gross, date_trunc('month', orders.ordered)\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.customer_id\nGROUP BY upper(customers.country), customers.id, date_trunc('month', orders.ordered)\nHAVING sum(orders.total * 1.2) IS NOT NULL OR lower(upper(customers.country)) = lower($fp1)\nORDER BY customers.id ASC, gross DESC, date_trunc('month', orders.ordered) ASC NULLS LAST\nLIMIT 100 OFFSET 200",
