  "sql": "SELECT customers.country, year(orders.created_at) AS year, count(*) AS orders, count(DISTINCT customers.id) AS buyers, avg(orders.total), max(orders.total * 1.2) AS max_gross\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.customer_id\nWHERE lower(orders.status) <> lower($fp1)\nGROUP BY customers.country, year(orders.created_at)\nHAVING count(*) >= $fp2 AND sum(orders.total) > $fp3\nORDER BY avg(orders.total) DESC, customers.country ASC NULLS FIRST\nLIMIT 50 OFFSET 100",
  "params": [
    { "name": "fp1", "kind": "string", "value": "cancelled" },
    { "name": "fp2", "kind": "int", "value": 2 },
    { "name": "fp3", "kind": "decimal", "value": "1000.5" }
  ],
