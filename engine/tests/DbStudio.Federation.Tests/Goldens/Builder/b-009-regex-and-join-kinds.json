  "model": {
    "version": 1,
    "tables": [
      {
        "id": "t1",
        "alias": "crm",
        "table": "customers",
        "as": "customers",
        "x": 40,
        "y": 40
      },
      {
        "id": "t2",
        "alias": "shop",
        "table": "orders",
        "as": "orders",
        "x": 360,
        "y": 40
      }
    ],
    "joins": [
      {
        "id": "j1",
        "type": "inner",
        "left": "t1",
        "right": "t2",
        "on": [
          {
            "leftColumn": "id",
            "rightColumn": "ref"
          }
        ]
      }
    ],
    "columns": [
      {
        "id": "c1",
        "tableId": "t1",
        "column": "name"
      }
    ],
    "filter": {
      "kind": "group",
      "id": "g1",
      "logic": "and",
      "items": [
        {
          "kind": "condition",
          "id": "f1",
          "column": "t1.name",
          "op": "regex",
          "values": [
            "^A.*"
          ]
        },
        {
          "kind": "condition",
          "id": "f2",
          "column": "t1.id",
          "op": "gte",
          "values": [
            10
          ]
        }
      ]
    },
    "sort": [
      {
        "ref": {
          "columnId": "c1"
        },
        "dir": "asc"
      }
    ],
    "limit": 5
  },
  "sql": "SELECT customers.name\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.ref\nWHERE regexp_matches(customers.name, $fp1, 'i') AND customers.id >= $fp2\nORDER BY customers.name ASC\nLIMIT 5",
  "params": [
    {
      "name": "fp1",
      "kind": "string",
      "value": "^A.*"
    },
    {
      "name": "fp2",
      "kind": "int",
      "value": 10
    }
  ],
  "warnings": [
    "joinKinds"
  ]
}
