  "sql": "SELECT customers.country, count(*) AS n_orders, count(DISTINCT customers.id) AS n_customers, avg(orders.total), min(orders.total) AS smallest, max(orders.ordered) AS last_order, customers.name\nFROM crm.customers AS customers\nINNER JOIN shop.orders AS orders ON customers.id = orders.customer_id\nGROUP BY customers.country, customers.name\nHAVING count(*) >= $fp1 AND sum(orders.total) > $fp2 AND avg(orders.total) < $fp3\nORDER BY avg(orders.total) DESC NULLS LAST, n_orders ASC",
  "params": [
    {
      "name": "fp1",
      "kind": "int",
      "value": 2
    },
    {
      "name": "fp2",
      "kind": "decimal",
      "value": "100.5"
    },
    {
      "name": "fp3",
      "kind": "float",
      "value": 1000
    }
  ],
